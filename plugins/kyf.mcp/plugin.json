{
  "schema": 1,
  "id": "kyf.mcp",
  "name": "MCP",
  "version": "0.1.0",
  "description": "配对本机 AI 客户端，管理 MCP 授权范围、调用记录与总开关；含安全与数据说明",
  "author": "Know Your Friends",
  "core": { "api": [1] },
  "runtime": { "type": "python", "entry": "backend/main.py" },
  "contributes": {
    "nav": [{ "id": "mcp-admin", "label": "MCP 管理", "page": "ui/index.html", "icon": "generic" }],
    "settings": {
      "schema": 1,
      "description": "授权连接、模式与联系人只在 MCP 管理页更改；这里仅保存新建客户端的默认授权模式。",
      "groups": [{
        "id": "pairing", "title": "配对",
        "fields": [{ "key": "defaultMode", "title": "新建客户端默认授权模式", "type": "select", "default": "full",
          "options": [{ "value": "full", "label": "完整授权" }, { "value": "per_contact", "label": "逐联系人授权" }],
          "description": "仅作为配对时的预选项；已创建客户端的模式随时可在管理页修改。" }]
      }],
      "links": [{ "label": "打开 MCP 管理", "nav": "mcp-admin" }]
    }
  }
}
